PORT=5000
MONGO_URI=mongodb://localhost:27017/shopsphere
JWT_SECRET=replace-with-a-strong-random-secret

# Password reset email through Resend. Leave unset locally to disable delivery.
RESEND_API_KEY=
PASSWORD_RESET_FROM=ShopSphere <no-reply@example.com>
# Trusted customer storefront origin used to create reset links (never Host headers).
CLIENT_URL=http://localhost:5173
